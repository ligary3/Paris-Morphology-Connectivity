&share
 wrf_core = 'ARW',
 max_dom = 3,
 start_date = '2022-07-16_00:00:00', '2022-07-16_00:00:00', '2022-07-16_00:00:00',
 end_date   = '2022-07-20_00:00:00', '2022-07-20_00:00:00', '2022-07-20_00:00:00',
 interval_seconds = 3600,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         = 1, 1, 2,
 parent_grid_ratio = 1, 3, 3,
 i_parent_start    = 1, 94, 72,
 j_parent_start    = 1, 95, 70,
 e_we              = 201, 181, 121,
 e_sn              = 201, 181, 121,
 geog_data_res     = 'default', 'default', 'default',
 dx = 9000,
 dy = 9000,
 map_proj = 'lambert',
 ref_lat   = 46.914156,
 ref_lon   = -0.432571,
 truelat1  = 43.00,
 truelat2  = 52.00,
 stand_lon = 2.352200,
 geog_data_path = '/path/to/wrf-work/data/WPS_GEOG/WPS_GEOG',
 opt_geogrid_tbl_path = '/path/to/wrf-work/src/WPS-4.7.0/geogrid/',
/

&ungrib
 out_format = 'WPS',
 prefix = 'ERA5',
/

&metgrid
 fg_name = 'ERA5',
 io_form_metgrid = 2,
/
